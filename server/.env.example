# ===== FOR LOCAL DEVELOPMENT =====
# Option 1: DATABASE_URL (connection string)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/taskforge

# Option 2: Individual DB params (fallback if DATABASE_URL not set)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=taskforge
# DB_USER=postgres
# DB_PASSWORD=postgres

JWT_SECRET=your_super_secret_jwt_key_here_dev_only
PORT=5000
CLIENT_URL=http://localhost:5173

# ===== FOR PRODUCTION (Render.com) =====
# These are set automatically by Render, do NOT commit them
# NODE_ENV=production
# DATABASE_URL=[auto-set by Render]
# JWT_SECRET=[auto-generated by Render]
# CLIENT_URL=[auto-set to render domain]
